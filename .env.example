# Archive node. Entries pin old fork blocks, and free-tier endpoints will not
# serve state that far back. The README describes what that failure looks like.
ETH_RPC_URL=

# Used by `cast etherscan-source` to pull the victim contract's verified source.
# Most of the setup work for an entry is this.
ETHERSCAN_API_KEY=

# Entries on other chains declare their own RPC variable and name it in the
# writeup. Nothing here is read automatically.
